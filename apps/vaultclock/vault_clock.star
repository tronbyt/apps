"""
Vault Clock — a LukeByt original.

A clock and weather readout dressed as a vault dweller's wrist terminal: green
phosphor CRT, a tab strip across the top, stat readouts flanking the screen, and
a little guy walking in place in the middle of it. Original pixel art, drawn as
run-length boxes so it themes and scales without shipping any bitmaps.

Weather comes from Open-Meteo, which needs no API key. Weather data by
Open-Meteo.com, CC BY 4.0 (https://open-meteo.com/).
"""

load("cache.star", "cache")
load("encoding/json.star", "json")
load("http.star", "http")
load("render.star", "canvas", "render")
load("schema.star", "schema")
load("time.star", "time")

# --- Animation budget -------------------------------------------------------
# 105 frames at 100 ms = 10.5 s, five turns of a 21-pose walk. The loop is this
# long because the CRT dropout has to be *rare* — once a loop, not once every
# few seconds — and the device just repeats the WebP for the rest of its dwell.
# Every cyclic element divides 105 exactly so the wrap is seamless: walk 21,
# scan band 35, colon blink 15, flicker 35.
DELAY_MS = 100
FRAME_COUNT = 105
POSE_HOLD = 1
BAND_PERIOD = 35
BLINK_PERIOD = 15

# --- Weather ----------------------------------------------------------------
API = "https://api.open-meteo.com/v1/forecast"
CURRENT = "temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,is_day,weather_code"
DAILY = "temperature_2m_max,temperature_2m_min"
FRESH_TTL = 900
RETRY_TTL = 60
STALE_TTL = 21600
STALE_MARK = 3600

DEFAULT_LOCATION = {
    "lat": "40.6781",
    "lng": "-73.9442",
    "locality": "Brooklyn",
    "timezone": "America/New_York",
}

# Open-Meteo documents exactly these 28 WMO codes. Labels are kept to 7
# characters so they fit the 1x left column.
WMO = {
    "0": ("CLEAR", "SUN"),
    "1": ("FAIR", "SUN"),
    "2": ("PARTLY", "PARTLY"),
    "3": ("CLOUDY", "CLOUD"),
    "45": ("FOG", "FOG"),
    "48": ("RIMEFOG", "FOG"),
    "51": ("LT DRIZ", "DRIZZLE"),
    "53": ("DRIZZLE", "DRIZZLE"),
    "55": ("HV DRIZ", "DRIZZLE"),
    "56": ("FRZDRIZ", "SLEET"),
    "57": ("FRZDRZ+", "SLEET"),
    "61": ("LT RAIN", "RAIN"),
    "63": ("RAIN", "RAIN"),
    "65": ("HV RAIN", "RAIN"),
    "66": ("FRZRAIN", "SLEET"),
    "67": ("FRZRAN+", "SLEET"),
    "71": ("LT SNOW", "SNOW"),
    "73": ("SNOW", "SNOW"),
    "75": ("HV SNOW", "SNOW"),
    "77": ("GRAINS", "SNOW"),
    "80": ("LT SHWR", "RAIN"),
    "81": ("SHOWERS", "RAIN"),
    "82": ("HV SHWR", "RAIN"),
    "85": ("SNWSHWR", "SNOW"),
    "86": ("SNWSHW+", "SNOW"),
    "95": ("T-STORM", "STORM"),
    "96": ("HAIL", "STORM"),
    "99": ("HAIL+", "STORM"),
}

# --- Palette ----------------------------------------------------------------
# hi = phosphor at full burn, mid = body fill, lo = dormant UI furniture,
# glow = the drifting CRT hum bar (alpha is appended per use).
THEMES = {
    "green": {"hi": "#4CFF9E", "mid": "#12A855", "lo": "#075C2E", "glow": "#9CFFC8"},
    "amber": {"hi": "#FFB63C", "mid": "#B06A0C", "lo": "#5A3406", "glow": "#FFDD9E"},
    "blue": {"hi": "#5AD8FF", "mid": "#0E86AE", "lo": "#07455C", "glow": "#B8EFFF"},
    "white": {"hi": "#EAFFF4", "mid": "#8AA396", "lo": "#3A4C42", "glow": "#FFFFFF"},
    "red": {"hi": "#FF6248", "mid": "#B02A16", "lo": "#571407", "glow": "#FFB3A4"},
    "violet": {"hi": "#C08CFF", "mid": "#6F35B4", "lo": "#38195E", "glow": "#E2C9FF"},
}

# A bad zone name makes time.in_location abort the render, and Starlark has no
# way to catch that — so the override is a closed list and anything outside it
# falls back to the location's own zone rather than taking the app down.
TIMEZONES = [
    ("auto", "Use the location's timezone"),
    ("UTC", "UTC"),
    ("America/New_York", "New York"),
    ("America/Chicago", "Chicago"),
    ("America/Denver", "Denver"),
