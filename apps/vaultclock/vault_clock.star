# --- Font metrics -----------------------------------------------------------
# INK = rows of blank space above the first lit pixel when a Text widget is
# placed at y=0; FONT_H = the widget's own height. Both measured off real
# renders so text can be positioned by the top of its ink.
INK = {"tom-thumb": 0, "tb-8": 1, "6x13": 2, "terminus-24": 4}
FONT_H = {"tom-thumb": 6, "tb-8": 8, "6x13": 13, "terminus-24": 24}

# --- Walk cycle -------------------------------------------------------------
# Both sets are reduced from the game's own walk animation, area-averaged from
# the native 242x337 capture — averaging over ~8x8 source pixels also washes out
# the CRT scanlines baked into it. Reduced at each target resolution rather than
# one being scaled up from the other.
# 21 poses, 15 x 18 — at nine pixels across the figure is close to a silhouette,
# which is all that fits. "#" full phosphor, "+" body fill, "-" faint, "." unlit.
