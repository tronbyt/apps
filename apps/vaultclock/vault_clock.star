# --- Drawing helpers --------------------------------------------------------

def at(x, y, child):
    return render.Padding(pad = (x, y, 0, 0), child = child)

def line(x, y, content, font, color):
    """Place text with its ink top at y."""
    return at(x, y - INK[font], render.Text(content = content, font = font, color = color))

def centered(x, y, width, content, font, color):
    """Place text horizontally centred in a column, ink top at y."""
    return at(x, y - INK[font], render.Box(
        width = width,
        height = FONT_H[font],
        child = render.Text(content = content, font = font, color = color),
    ))

def spread(x, y, width, left_text, right_text, font, color):
    """One readout pinned to each end of a band."""
    return at(x, y - INK[font], render.Box(
        width = width,
        height = FONT_H[font],
        child = render.Row(
            expanded = True,
            main_align = "space_between",
            cross_align = "start",
            children = [
                render.Text(content = left_text, font = font, color = color),
                render.Text(content = right_text, font = font, color = color),
            ],
        ),
    ))

def right_align(x, y, width, content, font, color):
    return at(x, y - INK[font], render.Box(
        width = width,
        height = FONT_H[font],
        child = render.Row(
            expanded = True,
            main_align = "end",
            cross_align = "start",
            children = [render.Text(content = content, font = font, color = color)],
        ),
    ))

def runs(row):
    """Run-length encode one row of a pixel grid."""
    out = []
    start = 0
    cur = row[0]
    for x in range(1, len(row)):
        if row[x] != cur:
            out.append((start, x - start, cur))
            start = x
            cur = row[x]
    out.append((start, len(row) - start, cur))
    return out

def grid(rows, levels, scale):
    """Draw a character grid as one Box per lit run — cheap enough to repeat
    across every animation frame, and it recolours with the theme."""
    drawn = []
    for row in rows:
        cells = []
        for run in runs(row):
            color = levels.get(run[2])
            if color == None:
                cells.append(render.Box(width = run[1] * scale, height = scale))
            else:
                cells.append(render.Box(width = run[1] * scale, height = scale, color = color))
        drawn.append(render.Row(children = cells))
    return render.Column(children = drawn)

# --- Data -------------------------------------------------------------------

def iround(v):
    if v >= 0:
        return int(v + 0.5)
    return -int(-v + 0.5)

def as_float(v, fallback):
    if type(v) == "float":
        return v
    if type(v) == "int":
        return float(v)
    if type(v) != "string":
        return fallback

    cleaned = v.strip()
    unsigned = cleaned[1:] if cleaned.startswith("-") or cleaned.startswith("+") else cleaned
    parts = unsigned.split(".")
    if len(parts) > 2:
        return fallback

    # Every remaining character must be an ASCII digit, so a sign or exponent
    # left in the middle is rejected here rather than raising inside float().
    # Not isdigit(): that accepts Unicode digits ("４０", "٥٢") which float()
    # then rejects, and the raise it was written to prevent happens anyway.
    seen = False
    for part in parts:
        for ch in part.elems():
            if ch not in "0123456789":
                return fallback
            seen = True
    if not seen:
        return fallback
    return float(cleaned)

def first(values):
    if values == None or type(values) != "list" or len(values) == 0:
        return None
    return values[0]

def fetch_weather(lat, lng, temp_unit, wind_unit):
    """Read the current conditions, preferring stale data over no data.

    A transport error (no DNS, no route, timeout) aborts the whole render —
    Starlark cannot catch it — which for a clock means a blank slot rather than
    a clock that is merely missing its weather. So the network is only touched
    when a gate key has expired, and the gate is written *before* the request:
    during an outage that costs one failed render per cooldown instead of every
    render until the network returns.

    The gate starts at RETRY_TTL and is only stretched to FRESH_TTL once a
    response has actually been parsed. Otherwise a single stumble — a Pi that
    renders before its wifi associates, a DHCP renewal, one DNS timeout — would
    suppress the weather for the whole refresh interval.
    """
    key = "vault-clock/%s/%s/%s/%s" % (lat, lng, temp_unit, wind_unit)
    gate = key + "#gate"
    cached = cache.get(key)

    if cache.get(gate) != None:
        return json.decode(cached) if cached != None else None
    cache.set(gate, "1", ttl_seconds = RETRY_TTL)

    url = "%s?latitude=%s&longitude=%s&current=%s&daily=%s&temperature_unit=%s&wind_speed_unit=%s&timezone=auto&forecast_days=1" % (
        API,
        lat,
        lng,
        CURRENT,
        DAILY,
        temp_unit,
        wind_unit,
    )

    # RETRY_TTL, not FRESH_TTL: pixlet's HTTP cache stores any cacheable-status
    # response for the full developer TTL, including a captive portal's or CDN
    # error page's 200 text/html — at FRESH_TTL every retry would be served the
    # same cached failure body for the whole window. Fetch cadence on success is
    # already limited by the gate above, and the parsed result is cached under
    # STALE_TTL, so the short HTTP TTL costs the success path nothing.
    resp = http.get(url, ttl_seconds = RETRY_TTL)

    # resp.json() raises on anything that is not JSON, and a raise here takes
    # the whole render down — so a captive portal or a CDN error page, which
    # both answer 200 with HTML, must be recognised before parsing rather than
    # after. A truncated body is caught the same way.
    if resp.status_code == 200 and looks_like_json(resp):
        body = resp.json()

        # Open-Meteo answers 400 with {"error": true, "reason": ...}, but it
        # also answers 200 with the weather blocks simply absent if a parameter
        # goes missing — so presence, not status, is the test.
        if type(body) == "dict" and not body.get("error") and type(body.get("current")) == "dict":
            parsed = shape(body)
            cache.set(key, json.encode(parsed), ttl_seconds = STALE_TTL)
            cache.set(gate, "1", ttl_seconds = FRESH_TTL)
            return parsed

    return json.decode(cached) if cached != None else None

def looks_like_json(resp):
    headers = resp.headers
    content_type = headers.get("Content-Type", headers.get("content-type", ""))
    if content_type.find("json") < 0:
        return False
    text = resp.body().strip()
    return text.startswith("{") and text.endswith("}")

def shape(body):
    current = body["current"]
    daily = body.get("daily", {})
    if type(daily) != "dict":
        daily = {}
    code = current.get("weather_code")
    return {
        "at": time.now().unix,
        "temp": current.get("temperature_2m"),
        "feels": current.get("apparent_temperature"),
        "humidity": current.get("relative_humidity_2m"),
        "wind": current.get("wind_speed_10m"),
        "is_day": 1 if current.get("is_day") == None else current.get("is_day"),
        "code": code,
        "high": first(daily.get("temperature_2m_max")),
        "low": first(daily.get("temperature_2m_min")),
    }

def temp_str(value, suffix):
    if value == None:
        return "--" + suffix
    return "%d%s" % (iround(value), suffix)

def int_str(value, suffix):
    if value == None:
        return "--" + suffix
    return "%d%s" % (iround(value), suffix)

def condition(weather):
    if weather == None:
        return ("NO LINK", "NONE")
    code = weather.get("code")
    if code == None:
        return ("UNKNOWN", "NONE")
    entry = WMO.get(str(int(code)))
    if entry == None:
        return ("UNKNOWN", "NONE")
    label, icon = entry
    if not weather.get("is_day", 1):
        icon = NIGHT_GLYPH.get(icon, icon)
    return (label, icon)

# --- Screen -----------------------------------------------------------------

def tab_strip(cfg, theme):
    """Pip-Boy tab row: the live tab burns bright over a bright rule segment,
    the rest sit dim. Returns (widgets, selected span) so the rule can break."""
    widgets = []
    x = 0
    span = (0, 0)
    for i in range(len(cfg["tabs"])):
        label, width = cfg["tabs"][i]
        color = theme["hi"] if i == 0 else theme["lo"]
        widgets.append(at(x, cfg["tab_y"] - INK[cfg["tab_font"]], render.Box(
            width = width,
            height = FONT_H[cfg["tab_font"]],
            child = render.Text(content = label, font = cfg["tab_font"], color = color),
        )))
        if i == 0:
            span = (x, width)
        x += width
    return (widgets, span, x)

def screen_chrome(cfg, theme, now, opts):
    """Everything that does not change between animation frames."""
    layers = []
    scale = cfg["icon_scale"]

    tabs, span, tabs_end = tab_strip(cfg, theme)
    layers.extend(tabs)

    # Corner indicator: meridiem in 12-hour mode; in 24-hour mode the weekday,
    # but only at 2x — the 1x corner is 11 px and "WED" needs 15.
    corner = ""
    if not opts["clock24"]:
        corner = now.format("PM")
    elif cfg["w"] >= 128:
        corner = now.format("Mon").upper()
    if corner:
        layers.append(right_align(tabs_end, cfg["tab_y"], cfg["w"] - tabs_end, corner, cfg["tab_font"], theme["mid"]))

    # Rule under the tabs, broken bright beneath the live tab.
    layers.append(at(0, cfg["rule1_y"], render.Box(width = cfg["w"], height = cfg["rule_h"], color = theme["lo"])))
    layers.append(at(span[0], cfg["rule1_y"], render.Box(width = span[1], height = cfg["rule_h"], color = theme["hi"])))

    if cfg["sub_y"] > 0:
        layers.append(line(2, cfg["sub_y"], "STATUS", "tb-8", theme["hi"]))
        layers.append(right_align(40, cfg["sub_y"], cfg["w"] - 42, opts["place"], "tb-8", theme["lo"]))

    lx, lw = cfg["col_l"]
    cx, cw = cfg["col_c"]
    rx, rw = cfg["col_r"]

    # Left column: date under the clock, plus the condition word where there
    # is room for it.
    layers.append(centered(lx, cfg["date_y"], lw, now.format("Mon 2").upper(), cfg["date_font"], theme["mid"]))
    if cfg["cond_y"] > 0:
        layers.append(centered(lx, cfg["cond_y"], lw, opts["cond"], cfg["cond_font"], theme["mid"]))

    # Middle column: the ground the walker paces on, and the limb-condition
    # dashes the real STAT screen floats outboard of the figure.
    layers.append(at(cx, cfg["ground_y"], render.Box(width = cw, height = 1 * scale, color = theme["lo"])))
    dash_w = 2 * scale
    for dy in cfg["dash_ys"]:
        for dx in (0, cw - dash_w):
            layers.append(at(cx + dx, dy, render.Box(
                width = dash_w,
                height = 1 * scale,
                color = theme["mid"],
            )))

    # Right column: glyph, temperature, today's range.
    icon = ICONS.get(opts["icon"], ICONS["NONE"])
    icon_w = 8 * scale
    layers.append(at(rx + (rw - icon_w) // 2, cfg["icon_y"], grid(icon, {
        "#": theme["hi"],
        "+": theme["mid"],
        "-": theme["lo"],
    }, scale)))
    layers.append(centered(rx, cfg["temp_y"], rw, opts["temp"], cfg["temp_font"], theme["hi"] if opts["live"] else theme["mid"]))
    layers.append(centered(rx, cfg["rh_y"], rw, opts["rh"], cfg["rh_font"], theme["mid"]))

    # Rule above the status strip.
    layers.append(at(0, cfg["rule2_y"], render.Box(width = cfg["w"], height = cfg["rule_h"], color = theme["lo"])))
    layers.extend(status_strip(cfg, theme, now, opts))

    return layers

# Go's time layout has no week-of-year verb, so the ISO week has to be derived
# from the day of the year and the weekday.
ISO_WEEKDAY = {"Mon": 1, "Tue": 2, "Wed": 3, "Thu": 4, "Fri": 5, "Sat": 6, "Sun": 7}

def dec31_weekday(year):
    """Weekday of 31 December, 0 = Sunday. The usual closed-form ISO helper."""
    return (year + year // 4 - year // 100 + year // 400) % 7

def iso_weeks_in_year(year):
    """53 when the year starts or ends on a Thursday, otherwise 52."""
    if dec31_weekday(year) == 4 or dec31_weekday(year - 1) == 3:
        return 53
    return 52

def iso_week(now):
    """ISO-8601 week number. The first days of January can belong to the last
    week of the previous year and the last days of December to week 1 of the
    next, which is the whole reason this is not just yday // 7."""
    year = int(now.format("2006"))
    week = (int(now.format("002")) - ISO_WEEKDAY[now.format("Mon")] + 10) // 7
    if week < 1:
        return iso_weeks_in_year(year - 1)
    if week > iso_weeks_in_year(year):
        return 1
    return week

def status_strip(cfg, theme, now, opts):
    font = cfg["bot_font"]
    y = cfg["bot_y"]
    mode = opts["strip"]

    if mode == "date":
        return [centered(0, y, cfg["w"], now.format("Mon 2 Jan 2006").upper(), font, theme["mid"])]

    if mode == "xp":
        # Week of the year as a level, and how far through the day it is as the
        # XP bar: one solid rectangle growing left to right inside a hairline
        # frame, the way the game draws it. A row of separate ticks reads as a
        # tally, not a bar.
        label = "LVL %d" % iso_week(now)
        bar_w = cfg["bar_w"]
        bar_h = cfg["bar_h"]
        bar_x = cfg["w"] - bar_w
        bar_y = y + (FONT_H[font] - bar_h) // 2
        inner_w = bar_w - 2
        inner_h = bar_h - 2

        # Round up: minute 1439 is the last of the day, so floor division would
        # leave the bar a pixel short of full for the whole of it.
        filled = ((now.hour * 60 + now.minute) * inner_w + 1439) // 1440

        layers = [
            at(bar_x, bar_y, render.Box(width = bar_w, height = bar_h, color = theme["mid"])),
            at(bar_x + 1, bar_y + 1, render.Box(width = inner_w, height = inner_h, color = theme["lo"])),
        ]
        if filled > 0:
            layers.append(at(bar_x + 1, bar_y + 1, render.Box(width = filled, height = inner_h, color = theme["hi"])))
        return [line(0, y, label, font, theme["mid"])] + layers

    # space_between leaves no gap at all once the two ends stop fitting, so an
    # Antarctic day ("-100/-129" beside "124 MPH") would run them together.
    # Closing up the wind unit buys the 4 px that keeps them apart.
    wind = opts["wind"]
    if len(opts["hilo"]) + len(wind) > cfg["strip_chars"]:
        wind = wind.replace(" ", "")
    return [spread(0, y, cfg["w"], opts["hilo"], wind, font, theme["mid"])]

def main(config):
    scale = 2 if canvas.is2x() else 1
    cfg = LAYOUT_2X if scale == 2 else LAYOUT_1X
    theme = THEMES.get(config.str("color", "green"), THEMES["green"])

    raw_location = config.get("location")
    location = json.decode(raw_location) if raw_location else DEFAULT_LOCATION
    if type(location) != "dict":
        location = DEFAULT_LOCATION
    lat = as_float(location.get("lat"), 40.6781)
    lng = as_float(location.get("lng"), -73.9442)

    timezone = config.str("timezone", "auto").strip()
    if timezone not in TZ_VALUES or timezone == "auto":
        # Only a location the user actually set outranks the device's own zone;
        # otherwise the built-in sample location would pin every unconfigured
        # device to New York.
        chosen = location.get("timezone") if raw_location else None
        timezone = chosen or config.get("$tz") or DEFAULT_LOCATION["timezone"]
    now = time.now().in_location(timezone)

    metric = config.bool("metric", False)
    temp_unit = "celsius" if metric else "fahrenheit"
    wind_unit = "kmh" if metric else "mph"
    wind_label = "KMH" if metric else "MPH"

    weather = fetch_weather(lat, lng, temp_unit, wind_unit)
    cond, icon = condition(weather)

    # A reading served out of the stale cache is drawn dimmer, so an hours-old
    # temperature never sits next to a live clock looking equally current.
    stamped = weather.get("at") if weather != None else None
    live = stamped == None or (time.now().unix - stamped) <= STALE_MARK

    if weather == None:
        temp, rh, hilo, wind = "--°", "--%", "--/--", "-- " + wind_label
    else:
        temp = temp_str(weather.get("temp"), "°")
        rh = int_str(weather.get("humidity"), "%")
        hilo = "%s/%s" % (
            temp_str(weather.get("high"), ""),
            temp_str(weather.get("low"), ""),
        )
        wind = "%s %s" % (int_str(weather.get("wind"), ""), wind_label)

    clock24 = config.bool("clock24", False)
    opts = {
        "clock24": clock24,
        "cond": cond,
        "icon": icon,
        "temp": temp,
        "rh": rh,
        "hilo": hilo,
        "wind": wind,
        "strip": config.str("strip", "vitals"),
        "live": live,
        "place": (location.get("locality") or location.get("description") or "").upper()[:16],
    }

    chrome = screen_chrome(cfg, theme, now, opts)

    # The clock is drawn twice — colon lit and colon dark — so the blink costs
    # one swapped layer per frame rather than a rebuilt widget tree.
    lx, lw = cfg["col_l"]
    hhmm = now.format("15:04") if clock24 else now.format("3:04")
    clock_on = centered(lx, cfg["time_y"], lw, hhmm, cfg["time_font"], theme["hi"])
    clock_off = centered(lx, cfg["time_y"], lw, hhmm.replace(":", " "), cfg["time_font"], theme["hi"])
    blink = config.bool("blink", True)

    levels = {"#": theme["hi"], "+": theme["mid"], "-": theme["lo"]}
    cx, _ = cfg["col_c"]

    # Each walk set is authored at its own resolution, so it is drawn 1:1.
    walk = WALK_2X if scale == 2 else WALK_1X
    poses = [at(cx, cfg["sprite_y"], grid(walk[i], levels, 1)) for i in range(len(walk))]

    scanlines = scanline_layer(cfg, config.str("scanlines", "auto"), scale)
    band = config.bool("band", True)
    flicker = config.bool("flicker", True)
    glitch = config.bool("glitch", True)

    frames = []
    for f in range(FRAME_COUNT):
        layers = list(chrome)
        layers.append(clock_off if (blink and (f % BLINK_PERIOD) >= BLINK_PERIOD // 2) else clock_on)
        layers.append(poses[(f // POSE_HOLD) % len(poses)])
        if scanlines != None:
            layers.append(scanlines)
        if band:
            layers.append(band_layer(cfg, theme, f, scale))
        if flicker:
            layers.append(flicker_layer(cfg, f))
        frame = render.Stack(children = layers)

        # The dropout displaces the finished picture, so it wraps the stack
        # rather than joining it.
        step = f - GLITCH_AT
        if glitch and step >= 0 and step < len(GLITCH):
            frame = glitch_frame(cfg, theme, frame, GLITCH[step], scale)
        frames.append(frame)

    return render.Root(
        delay = DELAY_MS,
        child = render.Stack(children = [
            render.Box(width = cfg["w"], height = cfg["h"], color = "#000000"),
            render.Animation(children = frames),
        ]),
    )

def scanline_layer(cfg, mode, scale):
    """Dark rows between the lit ones. Off by default at 1x, where a 5 px font
    cannot spare every other row; on at 2x, where every stroke is 2 px."""
    if mode == "off":
        return None
    if mode == "auto" and scale == 1:
        return None
    alpha = "99" if mode == "heavy" else ("40" if mode == "on" else "26")
    rows = []
    for _ in range(cfg["h"] // 2):
        rows.append(render.Box(width = cfg["w"], height = 1))
        rows.append(render.Box(width = cfg["w"], height = 1, color = "#000000" + alpha))
    return render.Column(children = rows)

def band_layer(cfg, theme, frame, scale):
    """The hum bar rolling down a mistuned CRT."""
    height = 3 * scale
    span = cfg["h"] + height
    y = (frame * span) // BAND_PERIOD % span - height
    if y < 0:
        # Rolling in over the top edge: show the part that has arrived.
        visible = height + y
        if visible <= 0:
            return render.Box(width = 1, height = 1)
        return render.Box(width = cfg["w"], height = visible, color = theme["glow"] + "16")
    return at(0, y, render.Box(width = cfg["w"], height = height, color = theme["glow"] + "16"))

# A fixed jitter table: the phosphor should waver, but a fresh random sequence
# every render would defeat the encoder's frame de-duplication.
FLICKER = [
    "00",
    "00",
    "08",
    "00",
    "00",
    "00",
    "10",
    "00",
    "00",
    "06",
    "00",
    "00",
    "00",
    "00",
    "0C",
    "00",
    "00",
    "00",
    "00",
    "04",
    "00",
    "00",
    "12",
    "00",
    "00",
    "00",
    "00",
    "0A",
    "00",
    "00",
    "00",
    "06",
    "00",
    "00",
    "0E",
]

# --- CRT dropout ------------------------------------------------------------
# Once per loop the picture loses sync for six frames: it jumps sideways, a
# bright rip runs across it and the phosphor over-brightens. dx and dy are
# non-negative because render.Padding cannot pad backwards, so the burst opens
# on a jump to the right and jitters from there — at 64 px wide that reads the
# same as a two-way tear. Offsets and tear rows are given in 1x pixels and
# scaled, so the dropout is the same size relative to the screen at both.
#
# It sits early in the loop on purpose. The server encodes only as much of the
# animation as the effective dwell (app display_time, else the device interval),
# so anything past that point is simply never written to the WebP — a dropout at
# frame 62 would vanish for any app shown for less than 6.2 s. At frame 26 it
# survives a dwell as short as 3.2 s, and on the usual 15 s dwell it plays twice,
# 10.5 s apart, which is the gap that matters. It also has to clear the end of
# the loop so its six frames never straddle the join.
GLITCH_AT = 26
GLITCH = [
    # (dx, dy, flash alpha, ((tear y, tear height), ...))
    (3, 0, "00", ((6, 2), (18, 1))),
    (1, 1, "1E", ((14, 1),)),
    (3, 0, "00", ((3, 3), (24, 1))),
    (0, 1, "12", ((21, 1),)),
    (2, 0, "0A", ((11, 2),)),
    (1, 0, "00", ()),
]

def glitch_frame(cfg, theme, scene, step, scale):
    """One frame of the dropout: the whole scene shifts, then the rip and the
    over-bright wash go on top of it, because they are artefacts of the tube
    rather than of the picture."""
    dx, dy, flash, bands = step
    layers = [render.Padding(pad = (dx * scale, dy * scale, 0, 0), child = scene)]
    for tear_y, tear_h in bands:
        y = tear_y * scale
        h = tear_h * scale
        layers.append(at(0, y, render.Box(width = cfg["w"], height = h, color = theme["glow"] + "4C")))

        # A dead line under the rip: a tear is a bright edge against a dark one.
        if y + h < cfg["h"]:
            layers.append(at(0, y + h, render.Box(width = cfg["w"], height = scale, color = "#000000CC")))
    if flash != "00":
        layers.append(render.Box(width = cfg["w"], height = cfg["h"], color = theme["glow"] + flash))
    return render.Stack(children = layers)

def flicker_layer(cfg, frame):
    alpha = FLICKER[frame % len(FLICKER)]
    if alpha == "00":
        return render.Box(width = 1, height = 1)
    return render.Box(width = cfg["w"], height = cfg["h"], color = "#000000" + alpha)

def get_schema():
    colors = [
        schema.Option(display = "Phosphor green", value = "green"),
        schema.Option(display = "Amber", value = "amber"),
        schema.Option(display = "Ice blue", value = "blue"),
        schema.Option(display = "Bone white", value = "white"),
        schema.Option(display = "Warning red", value = "red"),
        schema.Option(display = "Violet", value = "violet"),
    ]
    strips = [
        schema.Option(display = "Today's range and wind", value = "vitals"),
        schema.Option(display = "Level and day progress", value = "xp"),
        schema.Option(display = "Full date", value = "date"),
    ]
    scanlines = [
        schema.Option(display = "Auto (on at 128x64)", value = "auto"),
        schema.Option(display = "Off", value = "off"),
        schema.Option(display = "On", value = "on"),
        schema.Option(display = "Heavy", value = "heavy"),
    ]
    return schema.Schema(
        version = "1",
        fields = [
            schema.Location(
                id = "location",
                name = "Location",
                desc = "Where to read the weather. Weather data by Open-Meteo.com (CC BY 4.0) — no API key needed.",
                icon = "locationDot",
            ),
            schema.Toggle(
                id = "metric",
                name = "Metric units",
                desc = "Celsius and km/h instead of Fahrenheit and mph.",
                icon = "ruler",
                default = False,
            ),
            schema.Toggle(
                id = "clock24",
                name = "24-hour clock",
                desc = "Show 18:05 rather than 6:05.",
                icon = "clock",
                default = False,
            ),
            schema.Dropdown(
                id = "color",
                name = "Screen colour",
                desc = "Phosphor tint of the terminal.",
                icon = "palette",
                default = "green",
                options = colors,
            ),
            schema.Dropdown(
                id = "strip",
                name = "Status strip",
                desc = "What the bottom readout shows. Range is today's high and low.",
                icon = "gauge",
                default = "vitals",
                options = strips,
            ),
            schema.Dropdown(
                id = "scanlines",
                name = "Scanlines",
                desc = "Dark rows between the lit ones. Costs half the brightness.",
                icon = "barsStaggered",
                default = "auto",
                options = scanlines,
            ),
            schema.Toggle(
                id = "band",
                name = "Rolling hum bar",
                desc = "A bright band drifting down the screen.",
                icon = "waveSquare",
                default = True,
            ),
            schema.Toggle(
                id = "flicker",
                name = "Flicker",
                desc = "Unsteady phosphor.",
                icon = "bolt",
                default = True,
            ),
            schema.Toggle(
                id = "glitch",
                name = "CRT dropout",
                desc = "The screen tears and flashes for a moment every 10 seconds.",
                icon = "wandMagicSparkles",
                default = True,
            ),
            schema.Toggle(
                id = "blink",
                name = "Blinking colon",
                desc = "Pulse the colon in the clock.",
                icon = "circleDot",
                default = True,
            ),
            schema.Dropdown(
                id = "timezone",
                name = "Timezone",
                desc = "Only needed if you want the clock somewhere other than the weather location.",
                icon = "globe",
                default = "auto",
                options = [schema.Option(display = row[1], value = row[0]) for row in TIMEZONES],
            ),
        ],
    )
