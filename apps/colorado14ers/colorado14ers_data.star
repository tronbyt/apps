# 1. Original decoder function.
def _decode_outline(height, coordinates):
    if len(coordinates) % 2 != 0:
        fail("Mountain outline coordinate string must have even length.")

    grid = [
        [0 for x in range(64)]
        for y in range(height)
    ]

    for i in range(0, len(coordinates), 2):
        x = _COORD_VALUES[coordinates[i]]
        y = _COORD_VALUES[coordinates[i + 1]]

        if y >= height:
            fail("Mountain outline coordinate exceeds its image height.")

        grid[y][x] = 1

    return grid

# Build the original outlines for all 53 mountains.
MOUNTAIN_OUTLINES = {
    name: _decode_outline(packed[0], packed[1])
    for name, packed in _PACKED_OUTLINES.items()
}
