# /etc/solaredge-proxy.env
# Keep comments on their own lines (systemd does not support trailing comments).

# From your SolarEdge developer "Site Access" application
SOLAREDGE_CLIENT_ID=your_client_id_here
SOLAREDGE_CLIENT_SECRET=your_client_secret_here

# The key the Tronbyt app sends in the X-API-Key header (make up a long random string)
PROXY_API_KEY=your_proxy_api_key_here

PORT=10001

# --- Optional -------------------------------------------------------------
# Normally read from the token file. Set only if the proxy says the site ID is unknown.
# SOLAREDGE_SITE_ID=1234567

# Set BOTH of these to skip the one-time site-details call.
# SOLAREDGE_TIMEZONE=America/New_York
# SOLAREDGE_LIFETIME_START=2021-06-01

# Poll interval for "today" in minutes, during daylight hours and overnight.
# 30 around the clock is about 52 calls/day (~1,600/month). Do not go below 30 on the free tier.
# To save calls, e.g. POLL_DAY_MINUTES=60 and POLL_NIGHT_MINUTES=120 is about 24 calls/day.
# POLL_DAY_MINUTES=30
# POLL_NIGHT_MINUTES=30
# DAY_START_HOUR=6
# DAY_END_HOUR=21

# Hard stop for API calls per calendar month (free tier allows about 2000)
# SOLAREDGE_MONTHLY_CREDIT_LIMIT=1800

# Only if the lifetime call fails with HTTP 400: split long windows (days per call)
# SOLAREDGE_OVERVIEW_CHUNK_DAYS=366

# Where tokens and cached data live (the directory must be writable by the service user)
# SOLAREDGE_TOKEN_FILE=/var/lib/solaredge-proxy/token.json
# SOLAREDGE_STATE_FILE=/var/lib/solaredge-proxy/state.json
