"""
Applet: Third Age Events
Summary: Third Age events by date
Description: Shows events from Middle-earth's Third Age (The Hobbit and The Lord of the Rings) that happened on today's date.
Author: vhw46wpn4t-boop
"""

load("encoding/base64.star", "base64")
load("render.star", "render")
load("schema.star", "schema")
load("time.star", "time")

DEFAULT_TIMEZONE = "America/Los_Angeles"

BG = "#000000"
GOLD = "#976D23"
TXT = "#F5EED8"

TAG_COLORS = {
    "[H]": "#FFE22E",
    "[FOTR]": "#33CC66",
    "[TTT]": "#CC0000",
    "[ROTK]": "#0033CC",
}

# Full label for an event from one book.
TAG_LABELS = {
    "[H]": "Hobbit",
    "[FOTR]": "Fellowship",
    "[TTT]": "Two Towers",
    "[ROTK]": "Return",
}

# Short label used when an event spans two books, e.g. "[TTT]/[ROTK]".
TAG_SHORT = {
    "[H]": "H",
    "[FOTR]": "FOTR",
    "[TTT]": "TTT",
    "[ROTK]": "ROTK",
}

SCROLL_DELAYS = {
    "slow": 120,
    "medium": 80,
    "normal": 50,
    "fast": 30,
}

# Layout: a 12px ring on the left, a 52px text panel on the right.
TEXT_W = 52
SCROLL_H = 22
CHAR_W = 4  # tom-thumb glyph advance
MAX_CHARS = TEXT_W // CHAR_W

# The no-events animation was authored at 10 fps.
GIF_FRAME_DELAY = 100

NO_EVENTS_TEXT = "No Events"

# 12x23 One Ring icon shown beside the event text.
RING_PNG = base64.decode("""

""")

# 64x32 animated scene shown on days with no recorded events.
NO_EVENTS_GIF = base64.decode("""

""")

