def two_digits(n):
    return "0{}".format(n) if n < 10 else "{}".format(n)

def split_word(word):
    # Break a word that is wider than the panel: first at hyphens, then hard.
    if len(word) <= MAX_CHARS:
        return [word]

    parts = []
    pieces = word.split("-")
    for i in range(len(pieces)):
        piece = pieces[i] + ("-" if i < len(pieces) - 1 else "")
        for _ in range(len(piece)):
            if len(piece) <= MAX_CHARS:
                break
            parts.append(piece[:MAX_CHARS - 1] + "-")
            piece = piece[MAX_CHARS - 1:]
        if len(piece) > 0:
            parts.append(piece)
    return parts

def wrap_text(text):
    lines = []
    current = ""

    for word in text.split(" "):
        for part in split_word(word):
            if len(current) == 0:
                current = part
            elif len(current) + 1 + len(part) <= MAX_CHARS:
                current = current + " " + part
            else:
                lines.append(current)
                current = part

    if len(current) > 0:
        lines.append(current)

    return lines

def split_tags(text):
    # "[TTT]/[ROTK] 3019 - ..." -> (["[TTT]", "[ROTK]"], "3019 - ...")
    tags = []
    rest = text
    for _ in range(len(TAG_COLORS)):
        found = None
        for tag in TAG_COLORS:
            if rest.startswith(tag):
                found = tag
                break
        if found == None:
            break
        tags.append(found)
        rest = rest[len(found):]
        if rest.startswith("/"):
            rest = rest[1:]
        else:
            break
    return tags, rest.strip()

def render_tag_label(tags):
    if len(tags) == 1:
        return render.Text(TAG_LABELS[tags[0]], font = "tom-thumb", color = TAG_COLORS[tags[0]])

    children = []
    for i in range(len(tags)):
        if i > 0:
            children.append(render.Text("/", font = "tom-thumb", color = GOLD))
        children.append(render.Text(TAG_SHORT[tags[i]], font = "tom-thumb", color = TAG_COLORS[tags[i]]))
    return render.Row(children = children)

def render_ring():
    return render.Image(src = RING_PNG, width = 12, height = 32)

def render_header():
    return render.Box(
        width = TEXT_W,
        height = 5,
        color = BG,
        child = render.Column(
            expanded = True,
            main_align = "center",
            cross_align = "center",
            children = [
                render.Text("MIDDLE EARTH", font = "tom-thumb", color = GOLD),
            ],
        ),
    )

def event_rows(text):
    tags, body = split_tags(text)
    rows = []

    if len(tags) > 0:
        rows.append(render_tag_label(tags))

    for line in wrap_text(body):
        rows.append(render.Text(line, font = "tom-thumb", color = TXT))

    return rows

def event_weight(text):
    # Relative screen time for one event when rotating: longer text gets more.
    tags, body = split_tags(text)
    line_count = len(wrap_text(body))
    if len(tags) > 0:
        line_count = line_count + 1
    return max(45, 25 + line_count * 7)

def pick_event(events_today, now_unix):
    weights = [event_weight(e) for e in events_today]
    total = 0
    for w in weights:
        total = total + w
    position = now_unix % total

    elapsed = 0
    for i in range(len(events_today)):
        elapsed = elapsed + weights[i]
        if position < elapsed:
            return events_today[i]
    return events_today[0]

def scroll_events(events, repeats):
    block = []

    for i in range(len(events)):
        block.extend(event_rows(events[i]))

        if i < len(events) - 1:
            block.append(render.Box(width = TEXT_W, height = 3, color = BG))
            block.append(render.Box(width = TEXT_W, height = 1, color = GOLD))
            block.append(render.Box(width = TEXT_W, height = 3, color = BG))

    block.append(render.Box(width = TEXT_W, height = 8, color = BG))

    rows = []
    for _ in range(max(repeats, 1)):
        rows.extend(block)

    return render.Marquee(
        scroll_direction = "vertical",
        height = SCROLL_H,
        offset_start = SCROLL_H,
        offset_end = SCROLL_H,
        child = render.Column(children = rows),
    )

def no_events_text():
    return render.Box(
        width = TEXT_W,
        height = SCROLL_H,
        color = BG,
        child = render.Text(NO_EVENTS_TEXT, font = "tom-thumb", color = TXT),
    )

def layout(content, frame_delay):
    return render.Root(
        delay = frame_delay,
        child = render.Box(
            width = 64,
            height = 32,
            color = BG,
            child = render.Row(
                children = [
                    render_ring(),
                    render.Column(
                        children = [
                            render.Box(width = TEXT_W, height = 1, color = BG),
                            render_header(),
                            render.Box(width = TEXT_W, height = 1, color = BG),
                            render.Box(width = TEXT_W, height = 1, color = GOLD),
                            render.Box(width = TEXT_W, height = 1, color = BG),
                            content,
                            render.Box(width = TEXT_W, height = 1, color = BG),
                        ],
                    ),
                ],
            ),
        ),
    )

def main(config):
    timezone = config.get("$tz") or DEFAULT_TIMEZONE
    event_mode = config.get("event_mode", "single")
    no_events_display = config.get("no_events_display", "gif")
    frame_delay = SCROLL_DELAYS.get(config.get("scroll_speed", "normal"), 50)
    scroll_repeats = int(config.get("scroll_repeats", "1"))

    now = time.now().in_location(timezone)
    key = "{}-{}".format(two_digits(now.month), two_digits(now.day))
    events_today = EVENTS.get(key, [])

    if len(events_today) == 0:
        if no_events_display == "text":
            return layout(no_events_text(), frame_delay)
        return render.Root(
            delay = GIF_FRAME_DELAY,
            child = render.Image(src = NO_EVENTS_GIF, width = 64, height = 32),
        )

    if event_mode == "all":
        events_to_show = events_today
    else:
        events_to_show = [pick_event(events_today, int(now.unix))]

    return layout(scroll_events(events_to_show, scroll_repeats), frame_delay)

def get_schema():
    return schema.Schema(
        version = "1",
        fields = [
            schema.Dropdown(
                id = "event_mode",
                name = "Event Mode",
                desc = "Show all of today's events in one scroll, or rotate through one at a time.",
                icon = "list",
                default = "single",
                options = [
                    schema.Option(display = "One per cycle", value = "single"),
                    schema.Option(display = "All events", value = "all"),
                ],
            ),
            schema.Dropdown(
                id = "no_events_display",
                name = "No Events Display",
                desc = "What to show on days with no recorded events.",
                icon = "image",
                default = "gif",
                options = [
                    schema.Option(display = "Animation", value = "gif"),
                    schema.Option(display = "\"No Events\" text", value = "text"),
                ],
            ),
            schema.Dropdown(
                id = "scroll_repeats",
                name = "Scroll Repeats",
                desc = "How many times the event text repeats in the scroll.",
                icon = "rotateRight",
                default = "1",
                options = [
                    schema.Option(display = "1 time", value = "1"),
                    schema.Option(display = "2 times", value = "2"),
                    schema.Option(display = "3 times", value = "3"),
                    schema.Option(display = "4 times", value = "4"),
                ],
            ),
            schema.Dropdown(
                id = "scroll_speed",
                name = "Scroll Speed",
                desc = "How fast the event text scrolls.",
                icon = "gauge",
                default = "normal",
                options = [
                    schema.Option(display = "Slow", value = "slow"),
                    schema.Option(display = "Medium", value = "medium"),
                    schema.Option(display = "Normal", value = "normal"),
                    schema.Option(display = "Fast", value = "fast"),
                ],
            ),
        ],
    )
