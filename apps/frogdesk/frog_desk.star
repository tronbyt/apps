DEFAULT_FRAMES = [D_00, D_01, D_02, D_03, D_04, D_05, D_06, D_07, D_08]
SIDE_FRAMES = [S_00, S_01, S_02, S_03, S_04, S_05, S_06, S_07, S_08, S_09, S_10, S_11, S_12, S_13, S_14, S_15, S_16]
FLY_FRAMES = [F_00, F_01, F_02, F_03, F_04, F_05, F_06, F_07, F_08, F_09, F_10, F_11, F_12, F_13, F_14, F_15, F_16, F_17, F_18, F_19, F_20, F_21, F_22, F_23, F_24, F_25, F_26, F_27, F_28, F_29, F_30, F_31, F_32, F_33, F_34, F_35, F_36, F_37, F_38, F_39, F_40]
GLITCH_FRAMES = [G_00, G_01, G_02, G_03, G_04, G_05, G_06, G_07, G_08, G_09, G_10, G_11, G_12, G_13, G_14]
SLEEP_FRAMES = [L_00, L_01, L_02, L_03, L_04, L_05, L_06, L_07, L_08, L_09, L_10, L_11, L_12, L_13, L_14, L_15, L_16, L_17, L_18, L_19, L_20, L_21, L_22]
VACANT_FRAMES = [V_00, V_01, V_02, V_03, V_04, V_05, V_06, V_07, V_08, V_09, V_10, V_11, V_12, V_13]

DEFAULT_TIMED = [(0, 100), (1, 100), (2, 100), (3, 100), (4, 100), (5, 100), (6, 100), (7, 100), (8, 100), (0, 4000)]
SIDE_TIMED = [(0, 1000), (1, 125), (2, 125), (3, 20), (4, 200), (5, 20), (6, 20), (7, 20), (8, 200), (9, 20), (10, 20), (11, 20), (12, 200), (13, 20), (14, 125), (15, 125), (16, 3000)]
FLY_TIMED = [(0, 1000), (1, 50), (2, 50), (3, 50), (4, 50), (5, 50), (6, 50), (7, 50), (8, 50), (9, 1000), (10, 50), (11, 50), (12, 50), (13, 50), (14, 50), (15, 50), (16, 50), (17, 50), (18, 50), (19, 50), (20, 50), (21, 50), (22, 50), (23, 50), (24, 50), (25, 50), (26, 50), (27, 50), (28, 50), (29, 50), (30, 50), (31, 50), (32, 50), (33, 50), (34, 50), (35, 50), (36, 50), (37, 200), (38, 50), (39, 50), (40, 50)]
GLITCH_TIMED = [(0, 1000), (1, 150), (2, 250), (3, 220), (4, 170), (5, 170), (6, 170), (7, 100), (8, 100), (9, 350), (10, 250), (11, 350), (12, 350), (13, 330), (14, 1240)]
SLEEP_TIMED = [(0, 350), (1, 1000), (2, 350), (3, 1500), (4, 350), (5, 350), (6, 350), (7, 200), (8, 200), (9, 200), (10, 200), (11, 200), (12, 200), (13, 200), (14, 150), (15, 350), (16, 350), (17, 350), (18, 350), (19, 350), (20, 350), (21, 350), (22, 350)]
VACANT_TIMED = [(0, 2500), (1, 170), (2, 170), (3, 170), (4, 170), (5, 170), (6, 170), (7, 170), (8, 170), (9, 170), (10, 170), (11, 170), (12, 170), (13, 170)]

def _append_timed(children, frames, timed):
    for item in timed:
        idx = item[0]
        ms = item[1]
        repeats = int(ms / 5)
        for _ in range(repeats):
            children.append(render.Image(src = frames[idx]))

def _append_scene(children, name):
    if name == "default":
        _append_timed(children, DEFAULT_FRAMES, DEFAULT_TIMED)
    elif name == "side":
        _append_timed(children, SIDE_FRAMES, SIDE_TIMED)
    elif name == "fly":
        _append_timed(children, FLY_FRAMES, FLY_TIMED)
    elif name == "glitch":
        _append_timed(children, GLITCH_FRAMES, GLITCH_TIMED)
    elif name == "sleep":
        _append_timed(children, SLEEP_FRAMES, SLEEP_TIMED)
    elif name == "vacant":
        _append_timed(children, VACANT_FRAMES, VACANT_TIMED)
    else:
        fail("unknown scene: %s" % name)

def _choose_turn(artwork):
    # Reseed every render so scheduled refreshes make a fresh selection.
    random.seed(time.now().unix)

    if artwork == "default":
        return ["default"]
    elif artwork == "side":
        return ["side"]
    elif artwork == "fly":
        return ["fly"]
    elif artwork == "glitch":
        return ["glitch"]
    elif artwork == "sleep":
        return ["sleep"]
    elif artwork == "vacant":
        return ["vacant"]
    elif artwork == "desk":
        return [["default"], ["side"]][random.number(0, 1)]
    elif artwork == "mischief":
        return [["fly"], ["glitch"]][random.number(0, 1)]
    elif artwork == "after_hours":
        return [["sleep"], ["vacant"]][random.number(0, 1)]

    # 30,000 equally likely slots per render:
    #   Vacant: 9,900 slots = 33%
    #   Each of the other five scenes: 4,020 slots = 13.4%
    pick = random.number(0, 30000)
    if pick < 9900:
        return ["vacant"]
    elif pick < 13920:
        return ["default"]
    elif pick < 17940:
        return ["side"]
    elif pick < 21960:
        return ["fly"]
    elif pick < 25980:
        return ["glitch"]
    else:
        return ["sleep"]

def get_schema():
    artwork_options = [
        schema.Option(display = "All scenes (original rotation)", value = "all"),
        schema.Option(display = "Desk frog", value = "desk"),
        schema.Option(display = "Mischief", value = "mischief"),
        schema.Option(display = "After hours", value = "after_hours"),
        schema.Option(display = "Default", value = "default"),
        schema.Option(display = "Side-eye", value = "side"),
        schema.Option(display = "Fly", value = "fly"),
        schema.Option(display = "Glitch", value = "glitch"),
        schema.Option(display = "Sleep", value = "sleep"),
        schema.Option(display = "Vacant office", value = "vacant"),
    ]
    return schema.Schema(
        version = "1",
        fields = [
            schema.Dropdown(
                id = "artwork",
                name = "Artwork display",
                desc = "Choose the Frog Desk scene or a curated group of its original scenes.",
                icon = "image",
                default = "all",
                options = artwork_options,
            ),
            schema.Toggle(
                id = "finish_animation",
                name = "Finish each animation",
                desc = "Keep the selected scene playing until its original animation completes.",
                icon = "play",
                default = True,
            ),
        ],
    )

def main(config):
    artwork = config.str("artwork", "all")
    order = _choose_turn(artwork)
    print("Frog Desk turn: %s" % " -> ".join(order))
    children = []
    for name in order:
        _append_scene(children, name)
    return render.Root(
        child = render.Animation(children = children),
        delay = 5,
        show_full_animation = config.bool("finish_animation", True),
        max_age = 300,
    )
