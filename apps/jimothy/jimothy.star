"""
Applet: Jimothy
Summary: Run, Jimothy, run
Description: Displays an animated image of Jimothy running away.
Author: andyrak
"""

load("encoding/base64.star", "base64")
load("render.star", "render")

JIMOTHY_B64 = """"""

JIMOTHY_GIF = base64.decode(JIMOTHY_B64)

def main():
    return render.Root(
        child = render.Image(
            src = JIMOTHY_GIF,
            width = 64,
            height = 32,
        ),
    )
